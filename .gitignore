# اعتماديات Node
node_modules/
npm-debug.log*
yarn-error.log*

# إعدادات خاصة بالجهاز (Claude Code المحلية)
.claude/settings.local.json
.claude/launch.json

# أشجار عمل git المؤقتة داخل المستودع — نسخةٌ كاملةٌ من المستودع (‏٨٥ م.ب) تظهر
# «غير متتبَّعة»، فَـ‏git add -A‏ كان سيُودِعها داخل المستودع نفسه. إزالتُها تكون
# بـ‏git worktree remove‏ لا بالحذف اليدويّ (وإلا بقي تسجيلُها معطوباً).
.claude/worktrees/

# ملفات نظام التشغيل
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ملفات المحرّرات المؤقتة
*.swp
*~
.vscode/
.idea/

# نسخة أصلية احتياطية لإطار tall قبل الضغط الأفقي — محلية فقط، لا تُرفع
images/ui/frame-moon-tall.orig.png

# ملفات فوتوشوب المصدرية للإطارات (‏79MB) — الموقع لا يحمّلها إطلاقاً، والمستودع
# عامّ ونشرتُه GitHub Pages؛ فتبقى محلية على الجهاز ولا تُثقل تاريخ المستودع.
# (احذف السطر إن أردت رفعها بوصفها نسخة احتياطية.)
images/ui/originals/*.psd

# النسخ الاحتياطية ‎*.orig.png‎ من الإطارات قبل المعالجة — محلية فقط، لا تُرفع.
# ‏`**/`‎ يطابق صفرَ مجلّداتٍ أو أكثر، فيشمل السطرُ الواحدُ الحالتين معاً:
# ما كان في `images/ui/` مباشرةً وما كان في `images/ui/originals/`.
images/ui/**/*.orig.png

# سجلّ رموز الفتح الصريحة (مولّد generate-codes.cjs) — محلّيٌّ على جهاز المعلّم فقط.
# المستودع عامّ: يُدفَعُ `data/codes.json` (بصماتٌ فقط) ولا يُدفَعُ هذا أبداً.
codes-private.csv

# كتب المنهج وأدلة المعلم (حقوق الوزارة/كامبريدج) — محلية على جهاز المعلم فقط، لا تُرفع
# ملفات .md و.docx داخل المصادر تبقى مُتتبَّعة وتُرفع طبيعياً
المصادر/**/*.pdf

# ذاكرةُ بايتكود بايثون لأدواتِ مجلّد tools/ — تُولَّدُ تلقائياً عندَ كلِّ تشغيل،
# خاصّةٌ بنسخةِ المفسّرِ وجهازِه، ولا قيمةَ لها في المستودع.
__pycache__/
